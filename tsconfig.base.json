{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@lopr/core": ["./packages/core/src/index.ts"],
      "@lopr/tui": ["./packages/tui/src/index.ts"],
      "@lopr/vscode": ["./packages/vscode/src/index.ts"]
    }
  }
}
